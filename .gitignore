hs_err_pid*
replay_pid*

# Gradle
.gradle/
build/

# IDE (user-specific)
.idea/workspace.xml

# Backup files
*.bak

# Test reports
allure-results/

# Audit results
audit/
specifications-audit/

# Workshop output dirs (keep folders, ignore content)
src/test/testCases/**
!src/test/testCases/.gitkeep
src/test/kotlin/rawResults/**
!src/test/kotlin/rawResults/.gitkeep

# IDE (full ignore)
.idea/

# Node.js
node_modules/

# macOS
.DS_Store
**/.DS_Store

# Local drafts (never push)
drafts/

# Telemetry (machine-generated, local only)
tests/telemetry/events.jsonl
tests/telemetry/reflector-report.json

# Built Go tools (build on demand via scripts/build-tools.sh)
scripts/bin/

